// This is your Prisma schema file.
// Configure access to Vercel Postgres using DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============
// ENUMS
// ==============
enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING       // 已创建草稿订单，等待用户支付
  PROCESSING    // 已支付，制作中（支付成功自动进入）
  SHIPPED       // 已发货（Shopify Admin 标记 fulfilled）
  DELIVERED     // 已签收
  CANCELLED     // 已取消
  REFUNDED      // 已退款
}

// ==============
// NEXTAUTH V5 MODELS
// ==============

model User {
  id               String          @id @default(cuid())
  name             String?
  email            String?         @unique
  emailVerified    DateTime?
  image            String?
  role             Role            @default(USER)
  hasWelcomeCoupon Boolean         @default(false)
  accounts         Account[]
  sessions         Session[]
  
  // Generation limits
  maxConcurrentJobs   Int      @default(1)      // 同时进行的生图任务上限
  maxTotalGenerations Int      @default(3)       // 总生图次数上限
  isWhitelisted       Boolean  @default(false)   // 白名单（无限制）

  // Custom Relations
  generatedAssets GeneratedAsset[]
  orders          Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ==============
// CUSTOM BUSINESS MODELS
// ==============

enum GenerationStatus {
  PENDING
  COMPLETE
  FAILED
}

model GeneratedAsset {
  id                 String   @id @default(cuid())
  userId             String
  originalImage      String?  @db.Text
  resultImage        String?  @db.Text
  backImage          String?  @db.Text
  sideImage          String?  @db.Text
  showcaseImage      String?  @db.Text  // 效果展示图 URL（提示词2 生成）
  prompt             String?  @db.Text
  baseModelVariantId String?
  modelId            String?            // 实际使用的 AI 模型 ID
  status             GenerationStatus @default(COMPLETE) // Default true for legacy, handled in code
  
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[] // 被哪些订单项引用

  createdAt DateTime @default(now())
}

// ==============
// ORDER SYSTEM
// ==============

model Order {
  id                  String      @id @default(cuid())
  orderNumber         String      @unique  // 人类友好编号，如 "CF-20260330-A3F2K8"
  userId              String
  status              OrderStatus @default(PENDING)

  // Shopify 关联
  shopifyDraftOrderId String?     @unique  // Draft Order 的 GID
  shopifyOrderId      String?     @unique  // 正式订单 ID（支付后才有）
  invoiceUrl          String?     @db.Text // Shopify 结账 URL

  // 金额
  subtotalAmount      Float                // 商品小计
  discountCode        String?              // 优惠券代码
  discountAmount      Float       @default(0)  // 折扣金额
  totalAmount         Float                // 最终总价
  currency            String      @default("USD")

  // 物流
  trackingNumber      String?
  trackingUrl         String?     @db.Text
  shippedAt           DateTime?
  deliveredAt         DateTime?

  // 时间线
  paidAt              DateTime?
  cancelledAt         DateTime?

  // 关联
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items               OrderItem[]

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model OrderItem {
  id                  String    @id @default(cuid())
  orderId             String

  // 商品信息（快照）
  variantId           String            // Shopify variant GID
  title               String            // 商品名称快照
  price               Float             // 下单时单价
  quantity            Int
  size                String?           // "6cm" | "8cm" | "10cm" | "15cm"

  // 定制信息
  originalImageUrl    String?   @db.Text // 用户上传的原图 (Blob URL)
  generatedImageUrl   String?   @db.Text // AI 生成的效果图 (Blob URL)
  generatedAssetId    String?           // 关联到 GeneratedAsset（可选）
  customInstructions  String?   @db.Text // 用户备注

  // 关联
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  generatedAsset      GeneratedAsset? @relation(fields: [generatedAssetId], references: [id])

  createdAt           DateTime  @default(now())
}

// ==============
// HERO CAROUSEL CMS
// ==============

model HeroSlide {
  id            String   @id @default(cuid())
  sortOrder     Int      @default(0)
  tag           String                           // "Game Characters"
  tagZh         String?                          // "游戏角色"
  title         String                           // English title
  titleZh       String?                          // 中文标题
  description   String   @db.Text               // English description
  descriptionZh String?  @db.Text               // 中文描述
  imageUrl      String   @db.Text               // 背景大图 URL (Blob)
  thumbUrl      String   @db.Text               // 缩略图 URL (Blob)
  accent        String   @default("from-amber-500/20 via-orange-400/10 to-transparent")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==============
// AI MODEL CONFIGURATION
// ==============

model AiModel {
  id           String        @id @default(cuid())
  modelId      String        @unique              // API 模型标识符，如 "gemini-3.1-flash-image-preview"
  name         String                             // 显示名称
  description  String?                            // 描述
  provider     String                             // "gemini" | "jimeng"
  isActive     Boolean       @default(true)       // 启用/禁用
  sortOrder    Int           @default(0)          // 排序权重
  config       Json?                              // 供应商特定配置 (如即梦的 endpointEnvKey)
  stylePresets StylePreset[]                      // 反向关联：使用此模型的风格子类
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// ==============
// STYLE CONFIGURATION
// ==============

model StyleCategory {
  id          String        @id @default(cuid())
  slug        String        @unique              // 兼容 Phase 1 ID，如 "cartoon" / "low-poly"
  displayName String                             // 英文显示名，如 "Cartoon"
  name        String                             // 原始名称，如 "卡通风格"（备用）
  isOrderable Boolean       @default(true)       // false 时前台禁止下单
  accentColor String        @default("#6B7280")  // HEX 色，用于卡片高亮
  icon        String        @default("Box")      // Lucide icon 名称
  sortOrder   Int           @default(0)          // 排列顺序（升序）
  isActive    Boolean       @default(true)       // 停用时前台不显示
  presets     StylePreset[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model StylePreset {
  id              String         @id @default(cuid())
  slug            String                            // 大类内唯一，如 "cartoon-standard"
  categoryId      String
  name            String                            // 子类显示名，如 "Standard" / "Chibi"
  primaryPrompt   String         @db.Text           // 主视图生成提示词
  previewImageUrl String?        @db.Text           // Admin 上传的示意图 URL（Blob）
  aiModelId       String?                           // 可选：绑定特定 AI 模型（null 用系统默认）
  sortOrder       Int            @default(0)        // 大类内排序
  isActive        Boolean        @default(true)     // 停用时前台不显示
  category        StyleCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  aiModel         AiModel?       @relation(fields: [aiModelId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([categoryId, slug])
}
